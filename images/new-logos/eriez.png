<!-- Converted to CookieYes --><script type="text/javascript">NWS.Modules.LoadResources(['/Views/Display/Blocks/NWS/Blocks.DataPrivacy/CookieConsentBanner/CookieConsent.css']);</script>
	

	<!-- Cookie Yes Utility (Site-level) -->
<script type="text/javascript">
	 NWS.initNamespace("NWS.Eriez.Titan.CookieYes", function () {
		var _ = {
			updateBanner: function() {
				// Revisit Consent selectors
				const revisitConsent = ".cky-btn-revisit";
				const revistConsentSelectors = [revisitConsent];
				
				// US State Law selectors
				const us_bannerButton = ".cky-notice-btn-wrapper button.cky-btn-do-not-sell";
				const us_bannerClose = ".cky-banner-btn-close"; // covers gdpr selector
				const us_preferenceCenterConfirmButton = ".cky-opt-out-btn-wrapper button.cky-btn-confirm";
				const us_preferenceCenterCancelButton = ".cky-opt-out-btn-wrapper button.cky-btn-cancel";
				const us_preferenceCenterClose = ".cky-btn-close"; // covers gdpr selector
				const usStateLawSelectors = [us_bannerButton, us_bannerClose, us_preferenceCenterConfirmButton, us_preferenceCenterCancelButton, us_preferenceCenterClose];
				
				// GDPR Law selectors
				const gdpr_bannerButton = ".cky-notice-btn-wrapper button.cky-btn-customize";
				const gdpr_rejectButton = ".cky-notice-btn-wrapper button.cky-btn-reject";
				const gdpr_acceptButton = ".cky-notice-btn-wrapper button.cky-btn-accept";
				const gdpr_preferenceCenterRejectButton = ".cky-prefrence-btn-wrapper button.cky-btn-reject";
				const gdpr_preferenceCenterAcceptButton = ".cky-prefrence-btn-wrapper button.cky-btn-accept";
				const gdpr_preferenceCenterSaveButton = ".cky-prefrence-btn-wrapper button.cky-btn-preferences";
				const gdprLawSelectors = [gdpr_bannerButton, gdpr_rejectButton, gdpr_acceptButton, gdpr_preferenceCenterRejectButton, gdpr_preferenceCenterAcceptButton, gdpr_preferenceCenterSaveButton];
				
				const cookieYesElements = [...revistConsentSelectors, ...usStateLawSelectors, ...gdprLawSelectors];
				cookieYesElements.forEach(c => {
					const element = document.querySelector(c);
					if (element) {
						document.querySelector(c).addEventListener("click", function(e) {
							e.preventDefault();
						});
					}
				});
			},
			bannerReady: function() {
				const banner = document.querySelector(".cky-consent-container");
				if (banner) {
					_.updateBanner();
				}
				else {
					setTimeout(() => _.bannerReady(), 100);
				}
			}
		}
		return {
			init: function() {
				_.bannerReady();
			}
		}
	 });
	 NWS.Eriez.Titan.CookieYes.init();
</script>

